{
  "name": "cookbook-workspace",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix cookbook-api && npm install --prefix cookbook-app",
    "dev:api": "npm run dev --prefix cookbook-api",
    "dev:app": "npm run dev --prefix cookbook-app",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:app\"",
    "test:api": "npm test --prefix cookbook-api",
    "build:app": "npm run build --prefix cookbook-app",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "add:api": "npm install --prefix cookbook-api",
    "add:app": "npm install --prefix cookbook-app",
    "shadcn:add": "cd cookbook-app && npx shadcn@latest add"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
